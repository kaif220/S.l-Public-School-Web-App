@model List<AttendanceRecord>
@{ ViewData["Title"] = "My Attendance"; var pct = Model.Count == 0 ? 0 : Math.Round(Model.Count(a => a.Present) * 100.0 / Model.Count, 1); }
<div class="panel mb-3"><h5 class="mb-1">Overall: @pct%</h5><div class="progress"><div class="progress-bar bg-success" style="width:@pct.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div></div>
<div class="panel"><table class="table"><thead><tr><th>Date</th><th>Day</th><th>Status</th></tr></thead>
<tbody>@foreach (var a in Model) { <tr><td>@a.Date.ToString("dd MMM yyyy")</td><td>@a.Date.DayOfWeek</td><td>@if (a.Present) { <span class="badge bg-success">Present</span> } else { <span class="badge bg-danger">Absent</span> }</td></tr> }</tbody></table></div>
