@model List<Teacher>
@{ ViewData["Title"] = "Teachers"; }
<div class="panel">
  <div class="d-flex justify-content-end mb-3"><a class="btn btn-primary" asp-action="CreateTeacher"><i class="bi bi-plus-lg"></i> Add Teacher</a></div>
  <div class="table-responsive"><table class="table table-hover align-middle">
    <thead><tr><th>Name</th><th>Subject</th><th>Qualification</th><th>Phone</th><th>Email</th><th></th></tr></thead>
    <tbody>
    @foreach (var t in Model)
    {
      <tr><td>@t.AppUser.FullName</td><td>@t.Subject</td><td>@t.Qualification</td><td>@t.Phone</td><td>@t.AppUser.Email</td>
      <td><form asp-action="DeleteTeacher" asp-route-id="@t.Id" method="post" onsubmit="return confirm('Delete this teacher?')"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form></td></tr>
    }
    </tbody></table></div>
</div>
