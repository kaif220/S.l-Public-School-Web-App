@model List<FeeRecord>
@{ ViewData["Title"] = "Fees"; }
<div class="row g-3">
  <div class="col-lg-4"><div class="panel"><h6>Add Fee</h6>
    <form asp-action="AddFee" method="post">
      <div class="mb-2"><select name="StudentId" class="form-select" required>
        <option value="">-- Select Student --</option>
        @foreach (var s in (List<Student>)ViewBag.Students) { <option value="@s.Id">@s.AppUser.FullName (@s.ClassName-@s.Section)</option> }
      </select></div>
      <div class="mb-2"><input name="Description" class="form-control" placeholder="e.g. Tuition Fee - Q3" required /></div>
      <div class="mb-2"><input name="Amount" type="number" step="0.01" class="form-control" placeholder="Amount" required /></div>
      <div class="mb-2"><input name="DueDate" type="date" class="form-control" required /></div>
      <button class="btn btn-primary w-100">Add</button>
    </form></div></div>
  <div class="col-lg-8"><div class="panel"><div class="table-responsive"><table class="table align-middle">
    <thead><tr><th>Student</th><th>Description</th><th>Amount</th><th>Due</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var f in Model)
    {
      <tr><td>@f.Student.AppUser.FullName</td><td>@f.Description</td><td>₹@f.Amount.ToString("N0")</td><td>@f.DueDate.ToString("dd MMM yy")</td>
      <td>@if (f.IsPaid) { <span class="badge bg-success">Paid</span> } else { <span class="badge bg-danger">Pending</span> }</td>
      <td>@if (!f.IsPaid) { <form asp-action="MarkPaid" asp-route-id="@f.Id" method="post"><button class="btn btn-sm btn-success">Mark Paid</button></form> }</td></tr>
    }
    </tbody></table></div></div></div>
</div>
