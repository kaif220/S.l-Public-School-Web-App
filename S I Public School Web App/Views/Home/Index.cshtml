@{ ViewData["Title"] = "Home"; }
<section class="hero text-center">
  <div class="container">
    <h1>Welcome to S.I Public School</h1>
    <p class="lead my-4">Excellence in education, character and creativity — from Nursery to Class 10.</p>
    <a class="btn btn-warning btn-lg fw-semibold me-2" asp-action="Admissions">Apply for Admission</a>
    <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Portal Login</a>
  </div>
</section>

<div class="container" style="margin-top:-45px">
  <div class="row g-3 text-center">
    <div class="col-6 col-md-3"><div class="stat-box"><h2>@ViewBag.StudentCount+</h2><div>Students</div></div></div>
    <div class="col-6 col-md-3"><div class="stat-box"><h2>@ViewBag.TeacherCount+</h2><div>Teachers</div></div></div>
    <div class="col-6 col-md-3"><div class="stat-box"><h2>25+</h2><div>Years of Excellence</div></div></div>
    <div class="col-6 col-md-3"><div class="stat-box"><h2>100%</h2><div>Board Results</div></div></div>
  </div>
</div>

<div class="container my-5">
  <h2 class="section-title text-center mb-4">Why Choose Us</h2>
  <div class="row g-4">
    <div class="col-md-4"><div class="card card-hover p-4"><div class="icon-circle"><i class="bi bi-person-check"></i></div><h5>Experienced Faculty</h5><p class="text-muted mb-0">Qualified and caring teachers who inspire every child to learn.</p></div></div>
    <div class="col-md-4"><div class="card card-hover p-4"><div class="icon-circle"><i class="bi bi-pc-display"></i></div><h5>Smart Classrooms</h5><p class="text-muted mb-0">Digital boards, labs and modern learning tools in every class.</p></div></div>
    <div class="col-md-4"><div class="card card-hover p-4"><div class="icon-circle"><i class="bi bi-trophy"></i></div><h5>Sports &amp; Activities</h5><p class="text-muted mb-0">Cricket, football, yoga, music, dance, art and more.</p></div></div>
  </div>
</div>

<div class="container my-5">
  <div class="row g-4">
    <div class="col-lg-6">
      <h3 class="section-title mb-4">Latest Notices</h3>
      @foreach (var n in (List<Notice>)ViewBag.Notices)
      {
        <div class="panel mb-3"><div class="d-flex justify-content-between"><strong>@n.Title</strong><span class="badge bg-primary align-self-start">@n.PostedOn.ToString("dd MMM")</span></div><p class="mb-0 text-muted small mt-1">@n.Body</p></div>
      }
      <a asp-action="Notices">View all notices &rarr;</a>
    </div>
    <div class="col-lg-6">
      <h3 class="section-title mb-4">Upcoming Events</h3>
      @foreach (var e in (List<SchoolEvent>)ViewBag.Events)
      {
        <div class="panel mb-3 d-flex gap-3"><div class="text-center bg-primary text-white rounded p-2" style="min-width:64px"><div class="fs-4 fw-bold">@e.Date.Day</div><div class="small">@e.Date.ToString("MMM")</div></div><div><strong>@e.Title</strong><p class="mb-0 text-muted small">@e.Description</p></div></div>
      }
      <a asp-action="Events">View all events &rarr;</a>
    </div>
  </div>
</div>
