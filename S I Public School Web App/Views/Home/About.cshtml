@{ ViewData["Title"] = "About Us"; }
<div class="page-head text-center"><h1>About Us</h1></div>
<div class="container my-5">
  <div class="row g-4 align-items-center">
    <div class="col-md-6"><img class="img-fluid rounded-4 shadow" src="https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=900" alt="School" /></div>
    <div class="col-md-6">
      <h3 class="section-title mb-3">Our Story</h3>
      <p>S.I Public School was founded in 1998 with a simple vision: to give every child access to quality education in a safe, joyful and disciplined environment. Today we are a growing family of students, teachers and parents working together.</p>
      <p>We follow a balanced curriculum that blends academics with sports, arts, values and life skills.</p>
    </div>
  </div>
  <div class="row g-4 mt-4">
    <div class="col-md-6"><div class="card card-hover p-4"><h4><i class="bi bi-bullseye text-primary"></i> Our Mission</h4><p class="mb-0">To nurture confident, curious and compassionate learners who grow into responsible citizens.</p></div></div>
    <div class="col-md-6"><div class="card card-hover p-4"><h4><i class="bi bi-eye text-primary"></i> Our Vision</h4><p class="mb-0">To be a leading school known for academic excellence, innovation and strong values.</p></div></div>
  </div>
  <h3 class="section-title mt-5 mb-4">Principal's Message</h3>
  <div class="panel"><p class="mb-0 fst-italic">"Education is not just about marks; it is about shaping character. At S.I Public School we focus on the all-round growth of every child. We invite you to be a part of our journey." — <strong>Principal</strong></p></div>
</div>
